# Train data source: "mock" (built-in stand-in timetable) or "live" (Auckland Transport API).
# EXPO_PUBLIC_ values are bundled into the app and visible to users: never put secrets here.
# The AT API key is entered in the app and kept in expo-secure-store, never in env vars.
EXPO_PUBLIC_DATA_SOURCE=mock

# Optional, development only: your AT API key for the dev server's proxy, so web
# and dev builds work without saving a key in Settings. No EXPO_PUBLIC_ prefix:
# it stays in the dev server (scripts/at-dev-proxy.js) and never enters the app.
AT_API_KEY=
